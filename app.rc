#include <windows.h>
#include "resource.h"
IDI_APP ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,1,0,0
PRODUCTVERSION 2,1,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040A04B0"
    BEGIN
      VALUE "CompanyName", "OpenDock"
      VALUE "FileDescription", "OpenDock - notch, barra superior y dock para Windows"
      VALUE "ProductName", "OpenDock"
      VALUE "FileVersion", "2.1.0.0"
      VALUE "ProductVersion", "2.1.0"
      VALUE "InternalName", "OpenDock"
      VALUE "OriginalFilename", "OpenDock.exe"
      VALUE "LegalCopyright", "Copyright (C) 2026 OpenDock"
      VALUE "Comments", "Sin red, sin telemetria. Instalacion por usuario sin permisos de administrador."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040A, 1200
  END
END

