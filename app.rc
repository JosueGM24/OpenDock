#include <windows.h>
#include "resource.h"
IDI_APP ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040A04B0"
    BEGIN
      VALUE "CompanyName", "CornerRadius"
      VALUE "FileDescription", "CornerRadius - esquinas redondeadas de pantalla"
      VALUE "ProductName", "CornerRadius"
      VALUE "FileVersion", "1.1.0.0"
      VALUE "ProductVersion", "1.1.0"
      VALUE "InternalName", "CornerRadius"
      VALUE "OriginalFilename", "CornerRadius.exe"
      VALUE "LegalCopyright", "Copyright (C) 2026 CornerRadius"
      VALUE "Comments", "Sin red, sin telemetria. Instalacion por usuario sin permisos de administrador."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040A, 1200
  END
END
